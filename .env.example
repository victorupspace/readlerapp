# Copy to .env and fill in with your Supabase project values
# (Supabase dashboard → Project Settings → API).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional. Region where translate and examples run (default eu-central-1,
# the fastest for DeepL and Tatoeba). See the Supabase docs for region names.
# VITE_FUNCTIONS_REGION=eu-central-1
